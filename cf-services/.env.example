# ============================================
# Cloudflare Workers Environment Variables
# ============================================
#
# These are set via `wrangler secret put <name>`
# NOT in a .env file (Cloudflare Workers don't use .env)
#
# Run for each variable:
#   wrangler secret put SUPABASE_URL --env production
#   wrangler secret put SUPABASE_SERVICE_KEY --env production
#   etc.
#

# ============================================
# SHARED (All Workers)
# ============================================

# Supabase connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Internal authentication between Vercel and Workers
# Must match CF_INTERNAL_SECRET in Vercel
# Generate: openssl rand -hex 32
INTERNAL_SECRET=your_32_byte_hex_secret

# ============================================
# PAYMENTS WORKER ONLY
# ============================================

# Base RPC URL
BASE_RPC_URL=https://mainnet.base.org

# CDP API credentials (same as Vercel)
CDP_API_KEY_ID=organizations/.../apiKeys/...
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----...

# ============================================
# NEGOTIATION WORKER ONLY
# ============================================

# JWT secret for WebSocket authentication
# Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# ============================================
# DEPLOYMENT COMMANDS
# ============================================
#
# Set all secrets:
#   cd workers/webhooks && wrangler secret put SUPABASE_URL
#   cd workers/webhooks && wrangler secret put SUPABASE_SERVICE_KEY
#   cd workers/webhooks && wrangler secret put INTERNAL_SECRET
#
#   cd workers/payments && wrangler secret put SUPABASE_URL
#   cd workers/payments && wrangler secret put SUPABASE_SERVICE_KEY
#   cd workers/payments && wrangler secret put INTERNAL_SECRET
#   cd workers/payments && wrangler secret put BASE_RPC_URL
#   cd workers/payments && wrangler secret put CDP_API_KEY_ID
#   cd workers/payments && wrangler secret put CDP_API_KEY_SECRET
#
#   cd workers/negotiation && wrangler secret put SUPABASE_URL
#   cd workers/negotiation && wrangler secret put SUPABASE_SERVICE_KEY
#   cd workers/negotiation && wrangler secret put INTERNAL_SECRET
#   cd workers/negotiation && wrangler secret put JWT_SECRET
#
# Deploy:
#   npm run deploy:all
#
