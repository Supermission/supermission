# ============================================
# SUPERMISSION Environment Variables
# ============================================
# Base Mainnet (Chain ID: 8453)
#
# SETUP: cp .env.example .env.local
# Fill in all values. NEVER commit .env.local to Git!
# ============================================

# ============================================
# RPC CONFIGURATION
# ============================================
BASE_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Robinhood Chain (Arbitrum L2, chainId 4663). Falls back to the public RPC when
# unset; for production set an Alchemy (https://robinhood-mainnet.g.alchemy.com/v2/KEY)
# or QuickNode endpoint. WS optional.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_WS_URL=
# Server-side aliases (code reads these without NEXT_PUBLIC_ prefix)
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
NETWORK_ID=base

# ============================================
# USDC CONTRACT (BASE MAINNET)
# ============================================
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ============================================
# CDP (Server-side)
# ============================================
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ============================================
# SMART CONTRACT ADDRESSES
# ============================================
NEXT_PUBLIC_ERC8004_REGISTRY_ADDRESS=0x67F30a990bFa8356bFBC261971dA2AcfAF994490
